DATABASE_URL=sqlite:///./data/reconcileos.db
APP_MODE=local
# Hosted mode needs the Gateway/Cognito settings documented in docs/production-readiness.md.
LOCAL_OPERATOR=Local operator
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
MAX_UPLOAD_BYTES=10485760
MAX_IMPORT_ROWS=10000
FEE_RULES_PATH=../sample-data/fee-rules.json

# OpenAI investigation assistance. Add your own key only to the ignored .env file.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-5.4-mini-2026-03-17
LLM_TIMEOUT_SECONDS=30
LLM_RESPONSE_FORMAT=json_schema
LLM_ALLOW_LOOPBACK=false
